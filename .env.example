# ManoDost AI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ==================== AI Configuration ====================

# Groq API Key (Get from: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Google API Key (Optional, for future features)
GOOGLE_API_KEY=your_google_api_key_here

# ==================== Supabase Configuration ====================

# Supabase Project URL (Get from: Project Settings > API)
# Format: https://xxxxx.supabase.co
SUPABASE_URL=your_supabase_project_url

# Supabase Anon/Public Key (Get from: Project Settings > API)
# This is the "anon" public key, not the service_role key
SUPABASE_KEY=your_supabase_anon_key

# ==================== Flask Configuration ====================

# Flask Environment (development or production)
FLASK_ENV=development

# Flask Debug Mode (True or False)
FLASK_DEBUG=True

# Flask Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_flask_secret_key_here

# ==================== API Configuration ====================

# API Host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# API Port
API_PORT=8000

# ==================== CORS Configuration ====================

# Allowed Origins (comma-separated)
# For development: http://localhost:3000,http://10.0.2.2:8000
# For production: https://your-app-domain.com
CORS_ORIGINS=*

# ==================== Database Configuration ====================

# Database Connection Pool Size
DB_POOL_SIZE=10

# Database Timeout (seconds)
DB_TIMEOUT=30

# ==================== AI Model Configuration ====================

# Groq Model Name
GROQ_MODEL=llama-3.3-70b-versatile

# Max Tokens for AI Response
MAX_TOKENS=500

# Temperature (0.0 to 1.0, higher = more creative)
TEMPERATURE=0.7

# ==================== Logging Configuration ====================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log File Path
LOG_FILE=manodost.log

# ==================== Security Configuration ====================

# JWT Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_jwt_secret_here

# JWT Expiration (in seconds, 3600 = 1 hour)
JWT_EXPIRATION=3600

# ==================== Rate Limiting ====================

# Requests per minute per user
RATE_LIMIT=100

# ==================== Feature Flags ====================

# Enable voice chat (True or False)
ENABLE_VOICE_CHAT=False

# Enable push notifications (True or False)
ENABLE_PUSH_NOTIFICATIONS=False

# Enable analytics (True or False)
ENABLE_ANALYTICS=True

# ==================== External Services ====================

# Twilio (for SMS notifications, optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SendGrid (for email notifications, optional)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@manodost.com

# Firebase (for push notifications, optional)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ==================== Monitoring ====================

# Sentry DSN (for error tracking, optional)
SENTRY_DSN=your_sentry_dsn

# ==================== Notes ====================

# 1. Never commit the actual .env file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use different keys for development and production
# 4. Set restrictive permissions on .env file: chmod 600 .env
# 5. For production, use environment variables instead of .env file
